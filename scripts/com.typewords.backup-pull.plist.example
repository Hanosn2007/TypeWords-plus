<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.typewords.backup-pull</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/python3</string><string>/Users/YOUR_USER/Backups/TypeWords/automation/pull-sync-backups.py</string>
<string>--host</string><string>backup-user@YOUR_SERVER</string>
<string>--identity</string><string>/Users/YOUR_USER/Backups/TypeWords/automation/backup_ed25519</string>
<string>--output</string><string>/Users/YOUR_USER/Backups/TypeWords/daily</string>
</array>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>3600</integer>
<key>StandardOutPath</key><string>/Users/YOUR_USER/Backups/TypeWords/automation/pull.log</string>
<key>StandardErrorPath</key><string>/Users/YOUR_USER/Backups/TypeWords/automation/pull-error.log</string>
</dict></plist>
