[Unit]
Description=TypeWords Sync API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=typewords
Group=typewords
WorkingDirectory=/opt/typewords
Environment=TYPEWORDS_LISTEN=127.0.0.1:8080
Environment=TYPEWORDS_DATA_DIR=/var/lib/typewords
Environment=ALLOW_REGISTRATION=true
ExecStart=/opt/typewords/typewords-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/typewords

[Install]
WantedBy=multi-user.target
